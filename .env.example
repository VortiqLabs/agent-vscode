# VortiqLabs Agent MCP Server Configuration

# Host to bind the MCP server to (use 127.0.0.1 for local, or 0.0.0.0 inside Codespaces for remote network access)
HOST=127.0.0.1

# Port to listen on for MCP requests (default: 3000)
PORT=3000

# Secret Bearer token for authentication (Required for network/remote access)
# Generate a secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=your_secure_random_token_here

# Extension Agent API URL (default: http://127.0.0.1:43127)
VORTIQLABS_AGENT_URL=http://127.0.0.1:43127

# Shared Secret Token for MCP-to-Agent API Authentication
VORTIQLABS_AGENT_AUTH_TOKEN=your_secure_random_token_here

# Authorized workspace root directory (defaults to current working directory)
MCP_WORKSPACE_ROOT=/path/to/authorized/workspace

# Optional custom storage root for Codebase Indexer runtime
MCP_STORAGE_ROOT=~/.vortiqlabs-agent
