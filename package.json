{
  "name": "vortiqlabs-agent",
  "displayName": "VortiqLabs Agent",
  "description": "AI coding agent for VortiqLabs",
  "version": "0.3.0",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:vortiqlabs-agent.activity"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vortiqlabs-agent.workspace",
        "title": "VortiqLabs: Show Workspace"
      },
      {
        "command": "vortiqlabs-agent.fileRead",
        "title": "VortiqLabs: Read File"
      },
      {
        "command": "vortiqlabs-agent.fileWrite",
        "title": "VortiqLabs: Write File"
      },
      {
        "command": "vortiqlabs-agent.fileEdit",
        "title": "VortiqLabs: Edit File"
      },
      {
        "command": "vortiqlabs-agent.focusActivity",
        "title": "VortiqLabs: Focus Agent Activity"
      },
      {
        "command": "vortiqlabs-agent.signIn",
        "title": "VortiqLabs: Sign in to OneAuth"
      },
      {
        "command": "vortiqlabs-agent.signOut",
        "title": "VortiqLabs: Sign out of OneAuth"
      },
      {
        "command": "vortiqlabs-agent.getTunnel",
        "title": "VortiqLabs: Get Agent Tunnel URL and Port"
      },
      {
        "command": "vortiqlabs-agent.connectOpenAITunnel",
        "title": "VortiqLabs: Connect OpenAI Secure MCP Tunnel"
      },
      {
        "command": "vortiqlabs-agent.disconnectOpenAITunnel",
        "title": "VortiqLabs: Disconnect OpenAI Secure MCP Tunnel"
      }
    ],
    "configuration": {
      "title": "VortiqLabs Agent",
      "properties": {
        "vortiqlabsAgent.oneAuthBaseUrl": {
          "type": "string",
          "default": "https://oneauth.nishantapps.in",
          "description": "Base URL of the OneAuth service."
        },
        "vortiqlabsAgent.oneAuthClientId": {
          "type": "string",
          "default": "oa_FBp47kV6NxenFMogTQOiXeAi9gUszLDm",
          "description": "OAuth client ID registered for the VortiqLabs Agent extension."
        },
        "vortiqlabsAgent.openAITunnelRuntime": {
          "type": "string",
          "default": "tunnel-client-runtime-cloudflared",
          "description": "Managed OpenAI tunnel runtime is installed automatically in VS Code extension storage."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vortiqlabs-agent",
          "title": "VortiqLabs Agent",
          "icon": "resources/vortiqlabs-agent.svg"
        }
      ]
    },
    "views": {
      "vortiqlabs-agent": [
        {
          "id": "vortiqlabs-agent.activity",
          "name": "Agent Activity",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "mcp:dev": "npm run check-types && node esbuild.js && node dist/mcp.js",
    "mcp:start": "node dist/mcp.js",
    "vscode:prepublish": "npm run package",
    "package:vsix": "npm run package && vsce package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run test:unit",
    "test:unit": "npm run compile-tests && node --test out/test/**/*.test.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6",
    "express": "5.2.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "publisher": "vortiqlabs",
  "repository": {
    "type": "git",
    "url": "https://github.com/VortiqLabs/agent-vscode.git"
  }
}
